# Cloudflare Pages headers for Court Night. Same approach as the planner and the main site.
# no-transform stops Cloudflare injecting its Web Analytics beacon (the tool promises no analytics, no cookies, nothing sent anywhere).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000
  Cache-Control: public, max-age=0, must-revalidate, no-transform
